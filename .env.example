ENVIRONMENT=local
DEBUG=false
DATABASE_URL=postgresql+asyncpg://desk:desk@localhost:5432/desk
REDIS_URL=redis://localhost:6379/0
# Signs access tokens. Required when ENVIRONMENT=production. Generate with: openssl rand -hex 32
SECRET_KEY=change-me
# Lifetime of access tokens from POST /api/v1/auth/token.
ACCESS_TOKEN_TTL_MINUTES=60
# Ingestion worker (make worker).
INGESTION_POLL_SECONDS=1
INGESTION_LEASE_SECONDS=300
INGESTION_MAX_ATTEMPTS=5
CORS_ORIGINS=http://localhost:3000
LOG_LEVEL=INFO
LOG_JSON=false
WEB_CONCURRENCY=2
