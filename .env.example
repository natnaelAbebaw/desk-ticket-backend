ENVIRONMENT=local
DEBUG=false
DATABASE_URL=sqlite+aiosqlite:///./desk_ticket.db
# Required when ENVIRONMENT=production. Generate with: openssl rand -hex 32
SECRET_KEY=change-me
# Leave empty locally. Set a long random value in production.
API_KEY=
CORS_ORIGINS=http://localhost:3000
LOG_LEVEL=INFO
LOG_JSON=false
WEB_CONCURRENCY=2
