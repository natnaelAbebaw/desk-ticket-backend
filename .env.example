ENVIRONMENT=local
DEBUG=false
DATABASE_URL=sqlite+aiosqlite:///./desk_ticket.db
REDIS_URL=redis://localhost:6379/0
# Signs access tokens. Required when ENVIRONMENT=production. Generate with: openssl rand -hex 32
SECRET_KEY=change-me
# Lifetime of access tokens from POST /api/v1/auth/token.
ACCESS_TOKEN_TTL_MINUTES=60
CORS_ORIGINS=http://localhost:3000
LOG_LEVEL=INFO
LOG_JSON=false
WEB_CONCURRENCY=2
